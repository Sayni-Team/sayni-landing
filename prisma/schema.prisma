// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Todos los importes en CÉNTIMOS (Int): S/ 50.00 = 5000

generator client {
  // Generador clásico: el cliente se importa desde "@prisma/client"
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // conexión con pooling (la usa la web)
  directUrl = env("DATABASE_URL_UNPOOLED") // conexión directa (la usan las migraciones)
}

/* ── Estados ─────────────────────────────── */

enum ProductStatus {
  ACTIVE       // a la venta
  COMING_SOON  // visible pero no se puede comprar (Blend)
  HIDDEN       // no se muestra (Geisha 500g)
}

enum OrderStatus {
  PENDING    // creado, esperando el pago
  PAID       // Mercado Pago confirmó el pago
  SHIPPED    // enviado
  DELIVERED  // entregado
  CANCELLED  // cancelado o pago rechazado
}

/* ── Productos ───────────────────────────── */

model Product {
  id         String        @id // slug: "geisha-250", "pack-regalo-clasico"
  name       String
  image      String
  price      Int           // precio unitario en céntimos
  stock      Int           @default(0) // solo para productos SIN presentaciones
  status     ProductStatus @default(ACTIVE)
  variants   ProductVariant[] // presentaciones (grano / molido), cada una con su stock
  sortOrder  Int           @default(0)
  priceTiers PriceTier[]
  orderItems OrderItem[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// Precio por cantidad dentro de un ciclo (promociones tipo "3 por S/ 145").
// La cantidad se cuenta sumando todas las variantes del producto (grano + molido).
model PriceTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     // 1, 2, 3…
  price     Int     // precio total de esa cantidad, en céntimos

  @@unique([productId, quantity])
}

// Presentación de un producto (grano / molido) con su propio stock.
// La promoción se calcula sumando todas las presentaciones; el stock, por separado.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  // "grano" | "molido" (es lo que se guarda en OrderItem.variant)
  label     String  // "Grano" | "Molido"
  stock     Int     @default(0)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([productId, key])
}

/* ── Envíos ──────────────────────────────── */

// Distritos de Lima con tarifa. Provincia no va aquí: se cotiza por WhatsApp.
model ShippingZone {
  id        String  @id @default(cuid())
  district  String  @unique
  price     Int     // costo de envío en céntimos (IGV incluido)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  orders    Order[]
}

/* ── Pedidos ─────────────────────────────── */

model Order {
  id             String       @id @default(cuid())
  number         Int          @unique @default(autoincrement()) // número de pedido visible: #1024
  status         OrderStatus  @default(PENDING)

  customerName   String
  email          String
  phone          String
  address        String
  reference      String?
  shippingZoneId String
  shippingZone   ShippingZone @relation(fields: [shippingZoneId], references: [id])

  subtotal       Int          // productos, en céntimos
  shipping       Int          // envío, en céntimos
  total          Int          // subtotal + envío

  mpPreferenceId String?
  mpPaymentId    String?      @unique // evita procesar dos veces el mismo pago
  paidAt         DateTime?

  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String  // copia del nombre al momento de la compra
  variant     String? // "grano" | "molido"
  quantity    Int
  lineTotal   Int     // parte del total del producto que corresponde a esta línea, en céntimos
}

/* ── Panel de administración ─────────────── */

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String         // Argon2id: nunca se guarda la contraseña
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id // hash SHA-256 del token de la cookie (el token nunca se guarda)
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Intentos fallidos de login, para bloquear ataques de fuerza bruta
model LoginAttempt {
  key         String    @id // "email:correo@x.com" o "ip:1.2.3.4"
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

/* ── Libro de reclamaciones ──────────────── */

enum ComplaintKind {
  RECLAMO // disconformidad con el producto o servicio
  QUEJA   // malestar con la atención, sin relación con el producto o servicio
}

enum ComplaintStatus {
  PENDING   // pendiente de respuesta
  RESPONDED // respondido
}

model Complaint {
  id              String          @id @default(cuid())
  number          Int             @unique @default(autoincrement()) // número correlativo de la hoja
  createdAt       DateTime        @default(now())
  dueAt           DateTime        // fecha límite de respuesta

  // Consumidor
  consumerName    String
  docType         String          // DNI | CE | PASAPORTE
  docNumber       String
  address         String
  phone           String
  email           String
  isMinor         Boolean         @default(false)
  guardianName    String?         // padre, madre o apoderado si es menor de edad

  // Bien contratado
  goodType        String          // PRODUCTO | SERVICIO
  goodDescription String
  amount          Int?            // monto reclamado, en céntimos
  orderNumber     Int?            // n° de pedido, si lo indica

  // Reclamo o queja
  kind            ComplaintKind
  detail          String
  request         String          // lo que solicita el consumidor

  // Respuesta del proveedor
  status          ComplaintStatus @default(PENDING)
  response        String?
  respondedAt     DateTime?

  @@index([status, dueAt])
}